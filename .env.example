# Copia este archivo como .env (no se sube a GitHub).

# ── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# URL del frontend (EchoPrint-Music) para CORS y redirecciones
FRONTEND_URL=http://localhost:5173

# ── Reconocimiento de música: ACRCloud ─────────────────────────────────
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
# Opcionales: credenciales aparte para reconocer tarareo (si no, usa las de arriba)
# ACRCLOUD_HUMMING_HOST=
# ACRCLOUD_HUMMING_ACCESS_KEY=
# ACRCLOUD_HUMMING_ACCESS_SECRET=

# ── Spotify (crea la app en developer.spotify.com) ─────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback/

# ── AcoustID (opcional) ────────────────────────────────────────────────
ACOUSTID_API_KEY=

# ── Producción ─────────────────────────────────────────────────────────
# Sin DATABASE_URL se usa SQLite. En producción usa PostgreSQL (exige SSL):
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
# ANON_RECOGNIZE_RATE=10/hour
